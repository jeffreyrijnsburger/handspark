#!/usr/bin/python3
"""HandSpark's local CLI. Machine-readable output uses schema version 1."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

candidate = Path(__file__).resolve().parent.parent
BASE = candidate if (candidate / 'controller.py').exists() else Path.home() / '.local/share/teams-effects'
sys.path.insert(0, str(BASE))
from i18n import translate
from reactions import REACTIONS
from settings import CLOSE_ACTIONS, LANGUAGES, PREVIEW_FPS, PREVIEW_RESOLUTIONS, load_settings, update_settings

VERSION = (BASE / 'VERSION').read_text().strip()
UNIT = 'teams-effects.service'


def emit(value):
    print(json.dumps({'schema_version': 1, 'version': VERSION, **value}, ensure_ascii=False))


def main():
    language = load_settings()['language']
    parser = argparse.ArgumentParser(description='HandSpark: local gesture reactions for your Linux webcam.')
    parser.add_argument('--version', action='version', version='HandSpark ' + VERSION)
    parser.add_argument('--json', action='store_true', help='Machine-readable output for status, list, language, preview, output, on-start, on-close, tray and commands')
    parser.add_argument('--resolution', type=int, choices=PREVIEW_RESOLUTIONS, help='Preview or camera output height in pixels')
    parser.add_argument('--fps', type=int, choices=PREVIEW_FPS, help='Preview frames per second')
    parser.add_argument('command', nargs='?', default='panel', choices=(
        'panel', 'setup', 'start', 'stop', 'restart', 'status', 'list', 'language', 'preview', 'output', 'on-start', 'on-close', 'tray',
        'pause', 'resume', 'cancel', 'react', 'commands', *REACTIONS))
    parser.add_argument('argument', nargs='?')
    args = parser.parse_args()
    action = args.command
    if args.argument is not None and action not in ('language', 'react', 'on-start', 'on-close', 'tray'):
        parser.error('This command does not take an argument')
    if args.json and action not in ('status', 'list', 'language', 'preview', 'output', 'on-start', 'on-close', 'tray', 'commands'):
        parser.error('--json is supported by status, list, language, preview, output, on-start, on-close, tray and commands')
    if args.resolution is not None and action not in ('preview', 'output'):
        parser.error('--resolution is supported by preview and output')
    if args.fps is not None and action != 'preview':
        parser.error('--fps is supported by preview; camera output stays at 30 fps')
    if action == 'commands':
        emit({'ok': True, 'commands': {
            'status --json': 'Read camera status; never includes a preview',
            'list --json': 'List reaction identifiers and gestures',
            'start': 'Start the webcam and gesture recognition',
            'stop': 'Stop the webcam',
            'restart': 'Restart the webcam to apply saved output resolution',
            'react <id>': 'Play one reaction; starts the camera if needed',
            'cancel': 'Stop the current effect while keeping the camera on',
            'pause': 'Pause gestures while keeping the camera on',
            'resume': 'Resume gesture recognition',
            'language [nl|en]': 'Read or change the saved UI language',
            'preview [--resolution 360|540|720] [--fps 15|24|30]': 'Read or change preview quality without starting the camera',
            'output [--resolution 360|540|720]': 'Read or save camera output resolution; applies on next start/restart, fixed 30 fps',
            'on-close [stop|background|tray]': 'Read or save window closing behavior without changing the running camera',
            'on-start [tray|window]': 'Read or save startup visibility; tray is the default and enables the icon',
            'tray [on|off]': 'Read or save tray visibility; off restores window startup and resets hide-on-close to stop',
            'panel': 'Start in the tray by default, or raise controls when already running',
            'setup': 'Configure this user’s OBS profile and service'},
            'languages': list(LANGUAGES), 'reactions': list(REACTIONS)})
        return 0
    if action == 'list':
        reactions = [{'id': key, 'name': translate(language, 'reaction.' + key),
                      'gesture': translate(language, 'gesture.' + key)} for key in REACTIONS]
        if args.json:
            emit({'ok': True, 'reactions': reactions})
        else:
            for reaction in reactions:
                print(f'{reaction["id"]:12s} {reaction["gesture"]}')
        return 0
    if action == 'language':
        if args.argument:
            if args.argument not in LANGUAGES:
                parser.error(translate(language, 'language_usage'))
            language = update_settings(language=args.argument)['language']
        if args.json:
            emit({'ok': True, 'language': language, 'name': LANGUAGES[language]})
        else:
            print(f'{language}: {LANGUAGES[language]}')
        return 0
    if action == 'preview':
        updates = {}
        if args.resolution is not None:
            updates['preview_resolution'] = args.resolution
        if args.fps is not None:
            updates['preview_fps'] = args.fps
        values = update_settings(**updates) if updates else load_settings()
        preview = {key: values[key] for key in ('preview_resolution', 'preview_fps')}
        if args.json:
            emit({'ok': True, **preview})
        else:
            print(f'{preview["preview_resolution"]}p / {preview["preview_fps"]} fps')
        return 0
    if action == 'output':
        values = (update_settings(output_resolution=args.resolution)
                  if args.resolution is not None else load_settings())
        output = {'output_resolution': values['output_resolution'], 'output_fps': 30,
                  'applies_on_next_start': True}
        if args.json:
            emit({'ok': True, **output})
        else:
            print(f'{output["output_resolution"]}p / 30 fps; applies on next camera start/restart')
        return 0
    if action == 'status':
        if args.json:
            from control import request
            try:
                emit(request('status'))
            except (OSError, ValueError, RuntimeError):
                emit({'ok': False, 'error_code': 'camera_offline'})
                return 3
            return 0
        return subprocess.call(['systemctl', '--user', 'status', '--no-pager', UNIT])
    if action == 'on-start':
        if args.argument is not None and args.argument not in ('tray', 'window'):
            parser.error('Choose tray or window')
        updates = {'start_in_tray': args.argument == 'tray'}
        if args.argument == 'tray':
            updates['tray_enabled'] = True
        values = update_settings(**updates) if args.argument is not None else load_settings()
        if args.json:
            emit({'ok': True, 'start_in_tray': values['start_in_tray'], 'tray_enabled': values['tray_enabled']})
        else:
            print('tray' if values['start_in_tray'] else 'window')
        return 0
    if action == 'on-close':
        if args.argument is not None and args.argument not in CLOSE_ACTIONS:
            parser.error('Choose stop, background or tray')
        updates = {'close_action': args.argument}
        if args.argument == 'tray':
            updates['tray_enabled'] = True
        values = (update_settings(**updates)
                  if args.argument is not None else load_settings())
        if args.json:
            emit({'ok': True, 'close_action': values['close_action'], 'tray_enabled': values['tray_enabled']})
        else:
            print(values['close_action'])
        return 0
    if action == 'tray':
        if args.argument is not None and args.argument not in ('on', 'off'):
            parser.error('Choose on or off')
        values = load_settings()
        if args.argument is not None:
            updates = {'tray_enabled': args.argument == 'on'}
            if args.argument == 'off':
                updates['start_in_tray'] = False
                if values['close_action'] == 'tray':
                    updates['close_action'] = 'stop'
            values = update_settings(**updates)
        if args.json:
            emit({'ok': True, 'tray_enabled': values['tray_enabled'], 'close_action': values['close_action']})
        else:
            print('on' if values['tray_enabled'] else 'off')
        return 0
    if action == 'stop':
        return subprocess.call(['systemctl', '--user', 'stop', UNIT])
    if action in ('pause', 'resume', 'cancel'):
        from control import request
        request('cancel' if action == 'cancel' else 'automatic',
                **({} if action == 'cancel' else {'enabled': action == 'resume'}))
        return 0
    if action == 'react':
        if args.argument not in REACTIONS:
            parser.error('Choose a reaction from: ' + ', '.join(REACTIONS))
        action = args.argument
    from bootstrap import ensure_setup
    ensure_setup(BASE)
    if action == 'setup':
        return 0
    if action == 'panel':
        os.execv('/usr/bin/python3', ['/usr/bin/python3', str(BASE / 'panel.py')])
    keys = [key for key in ('DISPLAY', 'XAUTHORITY', 'WAYLAND_DISPLAY', 'XDG_SESSION_TYPE',
                            'XDG_CURRENT_DESKTOP') if key in os.environ]
    if keys:
        subprocess.run(['systemctl', '--user', 'import-environment', *keys], check=True)
    if action in ('start', 'restart'):
        # Keep the panel's QProcess attached to the actual start client. Killing
        # it must not leave a helper that can submit a late start after stop.
        os.execvp('systemctl', ['systemctl', '--user', action, UNIT])
    subprocess.run(['systemctl', '--user', 'restart' if action == 'restart' else 'start', UNIT], check=True)
    if action in REACTIONS:
        from control import request
        request('react', reaction=action)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
